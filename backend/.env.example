DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=sk-your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=sqlite:///./data/documents.db
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
FRONTEND_URL=http://localhost:3000
# Comma-separated production frontend origins. Keep the exact domains from Vercel, without trailing slash.
FRONTEND_URLS=https://ai-docu.fun,https://www.ai-docu.fun,https://frontend-theta-nine-69.vercel.app
DEMO_MODE=true
DAILY_UPLOAD_LIMIT=20
DAILY_SUMMARY_LIMIT=30
DAILY_CHAT_LIMIT=80
PER_IP_UPLOAD_LIMIT=2
PER_IP_SUMMARY_LIMIT=3
PER_IP_CHAT_LIMIT=10
# Current demo visitor key is based on IP. If auth is added later, replace it with user_id in code.
DEMO_MAX_FILE_SIZE_MB=2
DEMO_MAX_QUESTION_LENGTH=500
DEMO_MAX_DOCUMENT_CHARS=20000
DEMO_RETRIEVER_K=3
DEMO_LLM_MAX_TOKENS=600
